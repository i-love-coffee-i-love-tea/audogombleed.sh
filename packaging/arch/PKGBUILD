# Maintainer: Steffen Kremsler <github.com@gobuki.org>
pkgname=derakht-cli
pkgver=2.1.0
pkgrel=1
pkgdesc="Create CLIs with auto-completion, abbreviation and built-in help from config"
arch=('any')
url="https://github.com/i-love-coffee-i-love-tea/derakht-cli"
license=('BSD-2-Clause')
depends=('bash' 'gawk')
optdepends=('zsh: for zsh completion support')
source=("$pkgname-$pkgver.tar.gz::https://github.com/i-love-coffee-i-love-tea/derakht-cli/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$srcdir/derakht-cli-$pkgver"

    install -Dm755 derakht.sh "$pkgdir/usr/bin/derakht"
    install -Dm644 derakht.1 "$pkgdir/usr/share/man/man1/derakht.1"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
